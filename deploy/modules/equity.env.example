# Equity module (modules/equity): providers "equity" and, with JENGA_CARDS=true, "jenga-pgw".
# Copy to deploy/modules/equity.env. Register endpoint "equity": url http://equity-module:8090/,
# hooks ["provider"], secretEnv ZIRNIS_MODULE_EQUITY_SECRET. Then onboard channels EQUITY and JENGAPGW.
JENGA_ENV=uat
JENGA_API_KEY=
JENGA_MERCHANT_CODE=
JENGA_CONSUMER_SECRET=
JENGA_ACCOUNT_NUMBER=
JENGA_ACCOUNT_NAME=
# RSA private key (PEM path or inline) that signs requests; upload its public key to Jenga.
JENGA_PRIVATE_KEY=
JENGA_IPN_USERNAME=
JENGA_IPN_PASSWORD=
JENGA_CARDS=false
