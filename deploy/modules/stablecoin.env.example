# Copy to stablecoin.env, then fill in the exact deployed contract configuration.
# No signing key is accepted. Payers sign in their own wallets.
STABLECOIN_PROVIDER=usdc
MODULE_ADDR=:8090
STABLECOIN_RPC_URL=
# Decimal chain ID; 31337 for the local development fixture.
STABLECOIN_CHAIN_ID=
# Allowlisted six-decimal USDC contract, not an arbitrary token sharing its symbol.
STABLECOIN_TOKEN=
STABLECOIN_PAYMENTS_CONTRACT=
STABLECOIN_TREASURY=
# With Compose, set ZIRNIS_MODULE_STABLECOIN_SECRET in the root .env; Compose passes it
# as this module's ZIRNIS_MODULE_SECRET. When running by hand, export it separately.
