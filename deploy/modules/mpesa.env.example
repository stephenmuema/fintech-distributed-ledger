# M-Pesa module (modules/mpesa). Copy to deploy/modules/mpesa.env; never commit the copy.
# Register the module in Zirnis as endpoint "mpesa": url http://mpesa-module:8090/, hooks ["provider"],
# secretEnv ZIRNIS_MODULE_MPESA_SECRET. Then onboard channel MPESA: {"provider":"mpesa","module":"mpesa"}.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# B2C payouts and transaction status queries:
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# At least 32 random characters (openssl rand -hex 24): the secret path segment of callback URLs.
MPESA_CALLBACK_TOKEN=
MPESA_REJECT_UNKNOWN_ACCOUNTS=true
