# KCB module (modules/kcb): providers "kcb" and "kcb-mpesa". Copy to deploy/modules/kcb.env.
# Register endpoint "kcb": url http://kcb-module:8090/, hooks ["provider"], secretEnv ZIRNIS_MODULE_KCB_SECRET.
# Then onboard channels KCB {"provider":"kcb","module":"kcb"} and KCBMPESA {"provider":"kcb-mpesa","module":"kcb"}.
KCB_ENV=uat
KCB_CONSUMER_KEY=
KCB_CONSUMER_SECRET=
KCB_COMPANY_CODE=KE0010001
KCB_DEBIT_ACCOUNT=
KCB_STK_SHORTCODE=522522
KCB_STK_PASSKEY=
# KCB's public key (PEM path or inline) for IPN signatures; without it every IPN is refused.
KCB_IPN_PUBLIC_KEY=
KCB_CALLBACK_TOKEN=
